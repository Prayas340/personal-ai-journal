rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User root profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User journals subcollection (strict user isolation)
      match /journals/{journalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
