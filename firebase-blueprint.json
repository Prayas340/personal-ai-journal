{
  "entities": {
    "User": {
      "path": "users/{userId}",
      "description": "User profile document",
      "fields": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "photoURL": { "type": "string", "description": "Profile avatar URL" },
        "createdAt": { "type": "timestamp", "description": "Account registration timestamp" },
        "lastLogin": { "type": "timestamp", "description": "Last authenticated timestamp" }
      }
    },
    "Journal": {
      "path": "users/{userId}/journals/{journalId}",
      "description": "User conversation sessions, journals, structured summaries, and extracted metadata",
      "fields": {
        "title": { "type": "string", "description": "Session or Journal Title" },
        "messages": { "type": "array", "description": "List of turn messages [{role: 'user'|'model', content: string, timestamp: string}]" },
        "summary": { "type": "string", "description": "Executive structured summary generated by Gemini" },
        "tags": { "type": "array", "description": "Semantic categorizations and keywords" },
        "actionItems": { "type": "array", "description": "List of actionable items with priorities [{task: string, priority: 'High'|'Medium'|'Low', status: 'pending'|'completed'}]" },
        "sentiment": { "type": "string", "description": "Extracted emotional sentiment (e.g. Focused, Optimistic, Stressed, Urgent)" },
        "sentimentScore": { "type": "number", "description": "Numeric sentiment value (-1.0 to 1.0)" },
        "timestamp": { "type": "timestamp", "description": "Creation or last update timestamp" },
        "userId": { "type": "string", "description": "Owner user ID" }
      }
    }
  }
}
